/*
 * generated by Xtext 2.42.0
 */
grammar DebugInternalCBDL;

// Rule Root
ruleRoot:
	ruleImport
	*
	(
		ruleLogicalView
		    |
		rulePropetyView
	)
;

// Rule LogicalView
ruleLogicalView:
	(
		ruleComponent
		    |
		ruleConnetor
		    |
		ruleInteractionNature
	)*
;

// Rule PropetyView
rulePropetyView:
	(
		rulePropertyCategoryLibrary
		    |
		(
			'check'
			(
				ruleComplianceInstance
				    |
				ruleOverlayComplianceInstance
			)
			    |
			ruleSecurityControlInstance
		)*
	)
;

// Rule Import
ruleImport:
	'import'
	'<'
	ruleEString
	'>'
;

// Rule QualifiedName
ruleQualifiedName:
	RULE_ID
	(
		'.'
		RULE_ID
	)*
;

// Rule Component
ruleComponent:
	'component'
	ruleEString
	(
		'in'
		ruleQualifiedName
	)?
	(
		'{'
		rulePort
		(
			','
			rulePort
		)*
		'}'
	)?
	';'
;

// Rule Connetor
ruleConnetor:
	'connector'
	ruleEString
	':'
	ruleQualifiedName
	'-'
	ruleQualifiedName
	';'
;

// Rule InteractionNature
ruleInteractionNature:
	ruleData
;

// Rule EString
ruleEString:
	(
		RULE_STRING
		    |
		RULE_ID
	)
;

// Rule Port
rulePort:
	(
		rulePortIn
		    |
		rulePortOut
	)
;

// Rule PortOut
rulePortOut:
	ruleEString
	ruleOutput
	ruleQualifiedName
;

// Rule PortIn
rulePortIn:
	ruleEString
	ruleInput
	ruleQualifiedName
;

// Rule Data
ruleData:
	'data'
	ruleEString
	':'
	ruleDataType
	';'
;

// Rule DataType
ruleDataType:
	ruleEString
;

// Rule PropertyCategoryLibrary
rulePropertyCategoryLibrary:
	'library'
	RULE_ID
	'{'
	rulePropertyCategory
	*
	'}'
;

// Rule PropertyCategory
rulePropertyCategory:
	'category'
	RULE_ID
	'{'
	rulePropertyDefinition
	*
	'}'
;

// Rule PropertyDefinition
rulePropertyDefinition:
	(
		ruleComplianceDefinition
		    |
		ruleSecurityControlDefintion
		    |
		ruleOverlayComplianceDeffinition
	)
;

// Rule ComplianceDefinition
ruleComplianceDefinition:
	'compliance'
	RULE_ID
	(
		'('
		ruleDefinitionParameter
		(
			','
			ruleDefinitionParameter
		)*
		')'
	)?
	'{'
	'reference'
	'('
	(
		ruleStandardRef
		(
			','
			ruleStandardRef
		)*
	)?
	')'
	'comment'
	ruleEString
	'alloy'
	ruleEString
	'}'
;

// Rule OverlayComplianceDeffinition
ruleOverlayComplianceDeffinition:
	'overlay'
	RULE_ID
	(
		'('
		ruleDefinitionParameter
		(
			','
			ruleDefinitionParameter
		)*
		')'
	)?
	(
		'{'
		'instance'
		'('
		(
			ruleOverlayInstance
			(
				','
				ruleOverlayInstance
			)*
			')'
		)?
		'comment'
		ruleEString
		'}'
	)?
;

// Rule OverlayInstance
ruleOverlayInstance:
	ruleQualifiedName
	'('
	ruleEString
	(
		','
		ruleEString
		*
	)?
	')'
;

// Rule StandardRef
ruleStandardRef:
	ruleEString
	(
		':'
		ruleEString
	)?
;

// Rule SecurityControlDefintion
ruleSecurityControlDefintion:
	'securityControl'
	RULE_ID
	(
		'('
		ruleDefinitionParameter
		(
			','
			ruleDefinitionParameter
		)*
		')'
	)?
	(
		'{'
		'reference'
		'('
		(
			ruleStandardRef
			(
				','
				ruleStandardRef
			)*
		)?
		')'
		'comment'
		ruleEString
		'alloy'
		ruleEString
		'enforce'
		'('
		(
			ruleQualifiedName
			(
				','
				ruleQualifiedName
			)*
		)?
		')'
		'}'
	)?
;

// Rule DefinitionParameter
ruleDefinitionParameter:
	ruleParameterType
	RULE_ID
;

// Rule ComplianceInstance
ruleComplianceInstance:
	'atomic'
	ruleQualifiedName
	'('
	(
		ruleQualifiedName
		(
			','
			ruleQualifiedName
		)*
	)?
	')'
	';'
;

// Rule OverlayComplianceInstance
ruleOverlayComplianceInstance:
	'overlay'
	ruleQualifiedName
	'('
	(
		ruleQualifiedName
		(
			','
			ruleQualifiedName
		)*
	)?
	')'
	';'
;

// Rule SecurityControlInstance
ruleSecurityControlInstance:
	'securityReq'
	ruleQualifiedName
	'('
	(
		ruleQualifiedName
		(
			','
			ruleQualifiedName
		)*
	)?
	')'
	';'
;

// Rule Input
ruleInput:
	'<-'
;

// Rule Output
ruleOutput:
	'->'
;

// Rule ParameterType
ruleParameterType:
	(
		'COMPONENT'
		    |
		'PORT'
		    |
		'CONNECTOR'
	)
;

RULE_ID : '^'? ('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|'0'..'9')*;

RULE_INT : ('0'..'9')+;

RULE_STRING : ('"' ('\\' .|~(('\\'|'"')))* '"'|'\'' ('\\' .|~(('\\'|'\'')))* '\'');

RULE_ML_COMMENT : '/*' ( options {greedy=false;} : . )*'*/' {skip();};

RULE_SL_COMMENT : '//' ~(('\n'|'\r'))* ('\r'? '\n')? {skip();};

RULE_WS : (' '|'\t'|'\r'|'\n')+ {skip();};

RULE_ANY_OTHER : .;
