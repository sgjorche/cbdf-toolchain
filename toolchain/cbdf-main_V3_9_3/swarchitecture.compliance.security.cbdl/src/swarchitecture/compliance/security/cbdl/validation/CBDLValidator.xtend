	public static val INVALID_PARAMETER_TYPE = 'invalidParameterType'
	public static val UNIQ_PARAMETER_DEFINITION = 'uniqParameterDefinitiion'
	
	@Check
	def checkParameterDefinitionInstance(PropertyInstance instance) {
		var definition = instance.propertyDefinition
		var EReference literals = PropertyPackage.Literals.PROPERTY_INSTANCE__PARAMETERS
		
		
		
		if (definition !== null && definition.definitionParameters.size() !== instance.parameters.size()) {
			error('The number of parameter provided for the instantiated property does not match is definition', 
				literals,
				INVALID_PARAMETER_NUMBER)
		}
		
		if (definition !== null) {
			val lp = instance.parameters
			val lfp = definition.definitionParameters
			var i = 0
			while( i < lp.size() && i < lfp.size()){
				val usedtype = newArrayList()
				if(lp.get(i) instanceof Component) usedtype.add("COMPONENT")
				if(lp.get(i) instanceof Connector) usedtype.add("CONNECTOR")
				if(lp.get(i) instanceof Port) usedtype.add("PORT")			
	
				if(!usedtype.contains(lfp.get(i).type.name().toUpperCase)) {
					error(lfp.get(i).name + ' type is ' + lp.get(i).class.name + ', it does not match his definition. Excepted : ' + lfp.get(i).type.name().toUpperCase , 
					PropertyPackage.Literals.PROPERTY_INSTANCE__PROPERTY_DEFINITION,
					i,
					INVALID_PARAMETER_TYPE)	
				}
				i++
			} 
		}
	}
	
	
	@Check
	def uniqParameterDefinition4PropertyDefinition(PropertyDefinition definition) {
		val map = HashMultimap.create()
		for(e :definition.definitionParameters)
			map.put(e.name, e)
			
		for(e : map.asMap.entrySet) {
			val duplicates = e.value
			if(duplicates.size > 1){
				for (d:duplicates) 
					error("Duplicate definition parameter name",
						d,
						PropertyPackage.eINSTANCE.propertyDefinitionParameter_Name,
						UNIQ_PARAMETER_DEFINITION
					)
			}
		}
	}
	
