import <"ISO27002.cbdl">
import <"OWASP_ASVS.cbdl">

library ISO27002xOWASP {
  category SecureCommunication {

    overlay B_ISO_8_5_V2_10 (COMPONENT c1, COMPONENT c2) {
      instance (
        ISO27002.SecureCommunication.ISO_8_5(c1,c2),
        OWASP_ASVS.SecureCommunication.OWASP_V2_10(c1,c2),
        OWASP_ASVS.SecureCommunication.OWASP_V3_5(c1,c2)
      )
      comment "Enforces RBAC, MFA, and message source verification between {{ c1 }} and {{ c2 }} during login."
    }

    overlay B_ISO_8_24_V9_2 (COMPONENT c1, COMPONENT c2) {
      instance (
        ISO27002.SecureCommunication.ISO_8_24(c1,c2),
        OWASP_ASVS.SecureCommunication.OWASP_V9_2(c1,c2)
      )
      comment "Communication links between c1 and c2 must ensure confidentiality and integrity using cryptographic mechanisms."
    }

    overlay B_ISO_8_24 (COMPONENT c1, COMPONENT c2) {
      instance (
        ISO27002.SecureCommunication.ISO_8_24(c1,c2),
        OWASP_ASVS.SecureCommunication.OWASP_V9_2(c1,c2)
      )
      comment "Ensures encrypted communication between {{ c1 }} and {{ c2 }} using cryptographic mechanisms."
    }

    overlay B_ISO_8_6 (COMPONENT c1, COMPONENT c2) {
      instance (
        ISO27002.SecureCommunication.ISO_8_6(c1,c2)
      )
      comment "Applies rate limiting at the command dispatch layer between {{ c1 }} and {{ c2 }} to prevent flooding."
    }

    overlay B_ISO_8_2_V4_2 (COMPONENT c1, COMPONENT c2) {
      instance (
        ISO27002.SecureCommunication.ISO_8_2(c1,c2),
        OWASP_ASVS.SecureCommunication.OWASP_V4_2(c1,c2)
      )
      comment "Restricts elevated privileges between {{ c1 }} and {{ c2 }} to specific engineering roles."
    }

    overlay B_ISO_8_15_V7_1 (COMPONENT c1, COMPONENT c2) {
      instance (
        ISO27002.SecureCommunication.ISO_8_15(c1,c2),
        OWASP_ASVS.SecureCommunication.OWASP_V7_1(c1,c2),
        OWASP_ASVS.SecureCommunication.OWASP_V7_3(c1,c2)
      )
      comment "Ensures all inject/intercept actions between {{ c1 }} and {{ c2 }} are logged for non-repudiation."
    }

  }
}
