import <"SC.cbdl">

library OWASP_ASVS {
  category SecureCommunication {

    compliance OWASP_V9_2(COMPONENT c1, COMPONENT c2) {
      reference ("OWASP-V9.2" : "https://owasp.org/www-project-application-security-verification-standard/")
      comment "Encrypt all data in transit between {{ c1 }} and {{ c2 }}. Use TLS only. (Reformulated: quantifier domain pre-filtered by m.receiver = c2; logically equivalent to the original, verified via NMCheck_mini5.)"
      alloy "
        all m: MsgPassing | m.receiver = c2 implies (
          all d: Payload, t: Tick |
            (some t1: t.prevs | H_inject[c1, m, t1])
            implies
            (all c3: Component - c1 - c2 | not E_get_pld[c3, m, d, t])
        )
        and
        all m: MsgPassing | m.receiver = c2 implies (
          all t: Tick |
            H_inject[c1, m, t]
            implies
            (some t1: t.prevs | H_set_pld[c1, m, m.payload, t1])
        )
      "
    }

    compliance OWASP_V2_10(COMPONENT c1, COMPONENT c2) {
      reference ("OWASP-V2.10" : "https://owasp.org/www-project-application-security-verification-standard/")
      comment "Enforce RBAC for service-to-service auth between {{ c1 }} and {{ c2 }}."
      alloy "
        all m: MsgPassing, t: Tick |
          (H_intercept[c2, m, t] and
           (m.origin_sender = c1 or m.sender = c1))
          implies
          m.sender = m.origin_sender
      "
    }

    compliance OWASP_V7_1(COMPONENT c1, COMPONENT c2) {
      reference ("OWASP-V7.1" : "https://owasp.org/www-project-application-security-verification-standard/")
      comment "Ensure every inject and intercept action between {{ c1 }} and {{ c2 }} is observable in the connector's buffer trace."
      alloy "
        all m: MsgPassing, t: Tick |
          (H_inject[c1, m, t] implies Log.addEntry[m, t])
          and
          (H_intercept[c2, m, t] implies Log.addEntry[m, t])
      "
    }

    compliance OWASP_V3_5(COMPONENT c1, COMPONENT c2) {
      reference ("OWASP-V3.5" : "https://owasp.org/www-project-application-security-verification-standard/")
      comment "Prevent spoofing: messages at {{ c2 }} from {{ c1 }} must be properly injected by {{ c1 }}."
      alloy "
        all t2: Tick - tick/first, m: MsgPassing |
          E_get_src[c2, m, c1, t2] implies
            (some t1: t2.prevs | H_inject[c1, m, t1])
      "
    }

    compliance OWASP_V4_2(COMPONENT c1, COMPONENT c2) {
      reference ("OWASP-V4.2" : "https://owasp.org/www-project-application-security-verification-standard/")
      comment "Prevent privilege escalation between {{ c1 }} and {{ c2 }}: no component other than the addressed receiver may exercise read access on the communication."
      alloy "
        all m: MsgPassing, t: Tick, c3: Component - c1 - c2 |
          (m.origin_sender = c1 and m.receiver = c2)
          implies
          not H_intercept[c3, m, t]
      "
    }

    compliance OWASP_V7_3(COMPONENT c1, COMPONENT c2) {
      reference ("OWASP-V7.3" : "https://owasp.org/www-project-application-security-verification-standard/")
      comment "Ensure that audit-trace observability between {{ c1 }} and {{ c2 }} is preserved across all events."
      alloy "
        all m: MsgPassing, t: Tick |
          (H_inject[c1, m, t] implies Log.addEntry[m, t])
          and
          (H_intercept[c2, m, t] implies Log.addEntry[m, t])
      "
    }

  }
}
