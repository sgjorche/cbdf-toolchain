import <"SC.cbdl">

library OMB130 {
  category SecureCommunication {

    compliance OMB_4(COMPONENT c1, COMPONENT c2) {
      reference ("OMB-A130-4" : "https://www.whitehouse.gov/wp-content/uploads/legacy_drupal_files/omb/circulars/A130/a130revised.pdf#page=28")
      comment "Ensure that messages received by {{ c2 }} from {{ c1 }} were properly injected by {{ c1 }}, guaranteeing authentication of communication origin."
      alloy "
        all t2: Tick - tick/first, m: MsgPassing |
          E_get_src[c2, m, c1, t2] implies
            (some t1: t2.prevs | H_inject[c1, m, t1])
      "
    }

  }
}
