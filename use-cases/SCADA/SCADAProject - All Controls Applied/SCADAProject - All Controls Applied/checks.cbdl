check overlay NISTxOMB.SecureCommunication.B_AC_17_02(ControlCenter,FieldSite1);

// Threat: Repudiation
// Standard: NIST SP 800-53 Rev.5  Control: AU-2(03): Event Logging / Reviews and Updates  →  https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf
check overlay NISTxOMB.SecureCommunication.B_AU_02_03(ControlCenter,FieldSite1);

// Threat: Elevation of Privilege
// Standard: NIST SP 800-53 Rev.5  Control: AC-6(08): Least Privilege / Privilege Levels for Code Execution  →  https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf
