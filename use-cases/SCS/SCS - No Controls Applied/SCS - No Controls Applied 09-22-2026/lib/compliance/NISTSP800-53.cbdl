import <"SC.cbdl">

library NISTSP800 {
  category SecureCommunication {

    compliance SC_08_01(COMPONENT c1, COMPONENT c2) {
      reference ("SC-08(01)" : "https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf")
      comment "Ensure confidentiality and integrity for all transmissions between {{ c1 }} and {{ c2 }} using cryptographic mechanisms such as TLS or IPsec. (Reformulated: quantifier domain pre-filtered by m.receiver = c2; logically equivalent to the original, verified via NMCheck_mini5.)"
      alloy "
        all m: MsgPassing | m.receiver = c2 implies (
          all d: Payload, t: Tick |
            (some t1: t.prevs | H_inject[c1, m, t1])
            implies
            (all c3: Component - c1 - c2 | not E_get_pld[c3, m, d, t])
        )
        and
        all m: MsgPassing | m.receiver = c2 implies (
          all t: Tick |
            H_inject[c1, m, t]
            implies
            (some t1: t.prevs | H_set_pld[c1, m, m.payload, t1])
        )
      "
    }

    compliance AC_17_02_7(COMPONENT c1, COMPONENT c2) {
      reference ("AC-17(02)" : "https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf")
      comment "Enforce Multi-Factor Authentication (MFA) between {{ c1 }} and {{ c2 }}."
      alloy "
        all m: MsgPassing, t: Tick |
          (H_intercept[c2, m, t] and
           (m.origin_sender = c1 or m.sender = c1))
          implies
          m.sender = m.origin_sender
      "
    }

    compliance AU_02_03(COMPONENT c1, COMPONENT c2) {
      reference ("AU-02(03)" : "https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf")
      comment "Ensure every inject and intercept action between {{ c1 }} and {{ c2 }} is observable in the connector's buffer trace for non-repudiation."
      alloy "
        all m: MsgPassing, t: Tick |
          (H_inject[c1, m, t] implies Log.addEntry[m, t])
          and
          (H_intercept[c2, m, t] implies Log.addEntry[m, t])
      "
    }

    compliance SC_05_06(COMPONENT c1, COMPONENT c2) {
      reference ("SC-05(06)" : "https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf")
      comment "Limit the number of messages from {{ c1 }} to {{ c2 }} to at most one in any two consecutive Ticks, mitigating DoS risks."
      alloy "
        all t: Tick - tick/last |
          #{ m: MsgPassing |
            m.sender = c1 and
            m.receiver = c2 and
            m.sent in (t + t.next)
          } <= 1
      "
    }

    compliance AC_06_08(COMPONENT c1, COMPONENT c2) {
      reference ("AC-06(08)" : "https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-53r5.pdf")
      comment "Prevent privilege escalation between {{ c1 }} and {{ c2 }}: no component other than the addressed receiver may exercise read access on the communication."
      alloy "
        all m: MsgPassing, t: Tick, c3: Component - c1 - c2 |
          (m.origin_sender = c1 and m.receiver = c2)
          implies
          not H_intercept[c3, m, t]
      "
    }

  }
}
